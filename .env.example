# Neon Postgres connection string (Neon dashboard → Connection details)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used to sign admin sessions — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Google Gemini API key for the "Ask Al-Arz" assistant — free at https://aistudio.google.com/apikey
# Without it the site works and the assistant politely says it isn't switched on.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.5-flash-lite)
# GEMINI_MODEL=
